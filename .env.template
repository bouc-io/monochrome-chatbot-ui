
# Identity Provider Configuration
VITE_IDENTITY_PROVIDER=stub # options: keycloak, auth0, okta, stub (for local dev)

# Keycloak Configuration
VITE_SSO_SERVER_URL=https://sso.docker.internal
VITE_OAUTH_REALM=users
VITE_OAUTH_CLIENT_ID=chatbot-ui

# API URL
VITE_API_URL=https://api.docker.internal

# Local Development Tokens
# IMPORTANT: Replace these placeholder values with actual JWT tokens from your Keycloak instance
# To get real tokens:
# 1. Log into your Keycloak admin console
# 2. Or use browser developer tools after logging in via the web interface
# 3. Copy the access_token and refresh_token values
# 
# Example of what real tokens look like:
# VITE_ACCESS_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJrX...
# VITE_REFRESH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJrX...

VITE_ACCESS_TOKEN=your-access-token-here
VITE_REFRESH_TOKEN=your-refresh-token-here

# Available LLM Models Configuration
# JSON array of models with id, name, and description
VITE_AVAILABLE_MODELS=[{"id":"llama3.2:1b","name":"Llama 3.2","description":"Fast and efficient model"},{"id":"gemma3:1b","name":"Gemma 3","description":"Most capable model on a single GPU"}]

# Log level (debug, info, warn, error)
VITE_LOG_LEVEL=warn
