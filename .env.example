# ---------------------------------------------------------------------------
# monochrome-chatbot-ui — environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# API base URL for the chatbot-api-server backend (REST + SSE)
VITE_API_URL=https://api.pik8s.internal
# Ollama / LLM proxy endpoint (model listing and direct calls)
VITE_OLLAMA_API_URL=https://api.pik8s.internal/ollama

# --- Identity / auth --------------------------------------------------------
# Provider: keycloak | auth0 | okta | stub  (stub = no real IdP, local dev only)
VITE_IDENTITY_PROVIDER=stub
# SSO / Keycloak base URL
VITE_SSO_SERVER_URL=https://sso.pik8s.internal
# Keycloak realm
VITE_OAUTH_REALM=users
# OAuth client ID registered for this UI
VITE_OAUTH_CLIENT_ID=chatbot-ui
# Optional IdP hint to pre-select an identity broker (blank = none)
VITE_IDP_HINT=

# --- Local dev tokens (optional) --------------------------------------------
# Paste short-lived JWTs to skip interactive login during local dev.
# Leave blank in real deployments. NEVER commit real tokens.
VITE_ACCESS_TOKEN=
VITE_REFRESH_TOKEN=

# --- Misc -------------------------------------------------------------------
# Log verbosity: debug | info | warn | error
VITE_LOG_LEVEL=info
# JSON array of selectable models: [{"id","name","description"}]
VITE_AVAILABLE_MODELS=[{"id":"qwen3.5:2b","name":"Qwen 3.5","description":"Default local model"}]
